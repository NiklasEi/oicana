meta {
  name: Compile invoice template (PDF)
  type: http
  seq: 60
}

post {
  url: {{baseUrl}}/templates/invoice/compile
  body: json
  auth: none
}

script:pre-request {
  const fs = require('fs');
  const path = require('path');

  // Load invoice data from fixture file
  // Bruno CLI runs from collection root, so use relative path from there
  const fixturePath = path.join(process.cwd(), 'fixtures', 'invoice.json');
  const invoiceData = JSON.parse(fs.readFileSync(fixturePath, 'utf8'));

  // Set the request body
  req.setBody({
    jsonInputs: [
      {
        key: "invoice",
        value: invoiceData
      }
    ],
    blobInputs: []
  });
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should return PDF", function() {
    const contentType = res.headers['content-type'];
    expect(contentType).to.contain('application/pdf');
  });
}
