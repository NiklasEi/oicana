meta {
  name: Compile accessibility template (PDF)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/templates/accessibility/compile
  body: json
  auth: none
}

body:json {
  {
    "jsonInputs": [],
    "blobInputs": []
  }
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should return PDF", function() {
    const contentType = res.headers['content-type'];
    expect(contentType).to.contain('application/pdf');
  });
}
